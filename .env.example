# Produkční doména (bez lomítka na konci). Výchozí je https://silverdahl.cz – měňte jen při jiné doméně.
# Používá se pro kanonické URL, hreflang, og:url/og:image, strukturovaná data, sitemap a robots.txt.
# Stránky se předgenerují při buildu, proto musí být nastavená už při `npm run build`.
NUXT_PUBLIC_SITE_URL=https://silverdahl.cz

# Testovací nasazení: false = robots.txt zakáže procházení a všechny stránky dostanou noindex.
NUXT_PUBLIC_INDEXABLE=true

# Doručování kontaktního formuláře přes SMTP (libovolný poskytovatel, např. e-mailový hosting domény).
# Bez NUXT_SMTP_HOST, NUXT_CONTACT_FROM a NUXT_CONTACT_TO formulář zprávy NEodesílá a pravdivě to oznámí.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_CONTACT_FROM=
NUXT_CONTACT_TO=
