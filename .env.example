# Produkční doména (bez lomítka na konci). Dokud není nastavena, negenerují se kanonické URL ani og:url.
NUXT_PUBLIC_SITE_URL=

# Doručování kontaktního formuláře přes SMTP (libovolný poskytovatel, např. e-mailový hosting domény).
# Bez NUXT_SMTP_HOST, NUXT_CONTACT_FROM a NUXT_CONTACT_TO formulář zprávy NEodesílá a pravdivě to oznámí.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=465
NUXT_SMTP_SECURE=true
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_CONTACT_FROM=
NUXT_CONTACT_TO=
